# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor

# Go workspace file
go.work

# macOS
.DS_Store
**/.DS_Store

# IDE
.idea/
.vscode/
.history/

# Logs
*.log
log/

# Environment
.env
.env.ontology
*.env.local

# Backup files (except template files)
*.bak

