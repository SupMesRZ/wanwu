# scenic-ai-guide 环境变量示例
# 复制为 .env 或在运行环境中逐项设置。未列出的项在 application.yaml 中有开发默认值

# ---------- Spring ----------
# 激活的 profile，默认 dev。短信验证码不接真实服务商（定档），所有环境随登录响应回显
SPRING_PROFILES_ACTIVE=dev

# ---------- 数据库（必需） ----------
DB_URL=jdbc:mysql://127.0.0.1:3306/group_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=group_user
DB_PASSWORD=changeme

# ---------- Redis（必需，本地开发可用 docker run -d --name scenic-redis -p 6379:6379 redis:7.4-alpine） ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- LLM / Embedding（必需，无默认值，缺失则启动失败） ----------
# 阿里云北京 MaaS OpenAI 兼容接口的 chat key（模型 qwen3.6-flash）
API_KEY_CHAT=
# 阿里云百炼 OpenAI 兼容接口的 embedding key（模型 text-embedding-v4）
API_KEY_EMBEDDING=
# 模型装配开关，默认 openai；无密钥演示部署设为 none（此时上面两个 key 不再被要求，
# 问答降级为检索证据直出，AI 路线规划与多轮记忆不可用）
APP_AI_CHAT_MODEL=openai
APP_AI_EMBEDDING_MODEL=openai

# ---------- 安全（生产必须显式设置，默认值仅供开发） ----------
JWT_SECRET=

# ---------- 阿里云 OSS / NLS（数字人语音与静态资源，未配置时相关功能不可用） ----------
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=scenic-ai-guide
NLS_APP_KEY=

# ---------- Qdrant 向量库（可选，仅 qa-vector-enabled=true 时需要） ----------
QDRANT_HOST=qdrant.huohuospace.cn
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_USE_TLS=false
QDRANT_TIMEOUT_SECONDS=10
QDRANT_COLLECTION=scenic_knowledge

# ---------- 前端构建期（后台地图工作台用高德 JSAPI 2.0） ----------
GAODE_API_KEY=
GAODE_SECRET=
